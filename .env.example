# Copy this file to .env and set values appropriate for your local environment.
# Never commit .env or provider credentials.

COMPOSE_PROJECT_NAME=indico-ai-testing
APP_ENV=local

# Indico runs separately from this project. Phase 2 will start it on this URL.
BASE_URL=http://localhost:8080

# Project service ports
FRONTEND_PORT=4200
BACKEND_PORT=8000
AI_SERVICE_PORT=8001

# PostgreSQL Database Configuration (Phase 3)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testgen
DB_USERNAME=testgen
DB_PASSWORD=secret

# Later-phase configuration; leave credentials only in .env.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
